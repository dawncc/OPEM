{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python /absolute/path/to/hooks/capture.py",
            "statusMessage": "OPEM: capturing request"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python /absolute/path/to/hooks/capture.py",
            "statusMessage": "OPEM: archiving tool result"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python /absolute/path/to/hooks/capture.py",
            "statusMessage": "OPEM: saving pre-compaction summary"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python /absolute/path/to/hooks/capture.py",
            "statusMessage": "OPEM: saving session summary"
          }
        ]
      }
    ]
  }
}
